      "…"
    ],
    "normalization": "Split actual lines before whitespace normalization; identify proxies before NFKC; normalize retained fragments with NFKC; collapse whitespace to ASCII space; trim fragment ends",
    "numeric_punctuation": "Retain Chinese commas between decimal numbers, including signs, decimal fractions and exponents, allowing surrounding whitespace",
    "boundary_context": "Require at least one Han neighbor at normalized, whitespace-trimmed fragment edges; do not skip quotes or symbols; Han means CJK unified/compatibility ideograph blocks plus U+3007",
    "line_boundaries": "\\r\\n|[\\n\\r\\v\\f\\u001c-\\u001e\\u0085\\u2028\\u2029]",
    "sample_filter": {
      "version": "surface-noise-v5",
      "require_han": true,
      "line_edges": {
        "discard_first_fragment": true,
        "discard_unterminated_last_fragment": true
      },
      "action": "Discard pairs touching a flagged fragment; never reconnect across rejected fragments",
      "fragment_patterns": {
        "placeholder": "\\$P\\$|\\(I_M_G\\)",
        "structural_symbols": "[{}<>&=]",
        "fill_in_blank": "(?:^|[^A-Za-z0-9_])_{2,}(?=$|[^A-Za-z0-9_])|(?:^|[^A-Za-z0-9_])_(?=\\s|$)|□{2,}|_{3,}",
        "markdown_heading": "^\\s{0,3}#{1,6}(?:\\s|$)",
        "invisible_controls": "[\\u0000-\\u0008\\u000e-\\u001b\\u007f\\u200b-\\u200f\\u2060\\ufeff]",
        "discarded_source": "\\u0000",
        "replacement_character": "\\ufffd",
        "literal_line_escape": "\\\\+[rn]",
        "literal_control_escape": "\\\\+[tbfv0]",
        "literal_unicode_residue": "\\\\+u(?:00(?:[01][0-9A-Fa-f]|20|7[Ff]|85|[Aa]0)|1680|200[0-9A-Fa-f]|202[89Ff]|205[Ff]|2060|3000|[Ff][Ee][Ff][Ff])",
        "markdown_residue": "\\*{2,}|`|!?(?:\\[[^\\]]*\\])\\([^)]*\\)",
        "html_residue": "<\\s*/?[A-Za-z][A-Za-z0-9:_-]*(?:\\s|>|/>)|&(?:[A-Za-z][A-Za-z0-9]+|#[0-9]+|#x[0-9A-Fa-f]+);",
        "url": "https?://\\S+",
        "wiki_residue": "\\[\\[|\\]\\]|\\{\\{|\\}\\}|'{2,}"
      },
      "whole_fragment_pattern": "^[\\s.。…·⋯]*(?:更多|查看详情|点击展开|展开全文|返回顶部|阅读全文)[\\s.。…·⋯]*$",
      "empty_template_pattern": "[（(][\\s，,。；;！？!?…]*[）)]"
    },
    "symbol_window": {
      "max_distance": 18,
      "distance": "Sum of code-point distances to nearest non-proxy symbol on each side, within the same physical line and without crossing a discard barrier; includes intervening spaces; symbols need not match",
      "symbols_file": "unicode-symbols.json",
      "symbols_sha256": "024a3a72c99787d47611fc6b75dc10b465db93c1c62f5f853c40290641abbc72",
      "action": "Keep a rejected proxy as a fragment delimiter/barrier; skip its target only, never fuse the two sides or reconnect nonadjacent fragments"
    },
    "source_filter": {
      "barrier": "\u0000",
      "action": "Replace discarded source spans with barriers while preserving every original line separator; reject every pair touching a barrier, never reconnect surviving text",
      "balanced_spans": [
        [
          "{{",
          "}}"
        ],
        [
          "{|",
          "|}"
        ],
        [
          "-{",
          "}-"
        ]
      ],
      "span_patterns": {
        "fenced_code": "(`{3,}|~{3,})[\\s\\S]*?(?:\\1|$)",
        "inline_code": "`[^`\\r\\n\\v\\f\\u001c-\\u001e\\u0085\\u2028\\u2029]*`",
        "html_comment": "<!--[\\s\\S]*?(?:-->|$)",
        "html_content": "<(script|style|math|code|timeline|gallery|mapframe|syntaxhighlight|ref)\\b[^>]*(?<!/)>[\\s\\S]*?(?:</\\1\\s*>|$)",
        "html_tag": "</?[A-Za-z][A-Za-z0-9:_-]*(?:\\s[^<>]*|/?)>",
        "markdown_bold": "(\\*{2,})[^\\r\\n\\v\\f\\u001c-\\u001e\\u0085\\u2028\\u2029]*?\\1",
        "markdown_underline": "(?<![A-Za-z0-9_])(_{2,})[^\\r\\n\\v\\f\\u001c-\\u001e\\u0085\\u2028\\u2029]*?\\1(?![A-Za-z0-9_])"
      },
      "span_exemptions": {
        "markdown_underline": "^__[A-Za-z][A-Za-z0-9_]*__$"
      }
    }
  },
