{
  "manifest_version": 3,
  "name": "Super Reader - 中文视觉分块阅读",
  "version": "0.1.0",
  "minimum_chrome_version": "109",
  "description": "将中文长句按词义边界切成短语块，并用细竖向分隔线辅助阅读。",
  "permissions": ["activeTab", "offscreen", "scripting"],
  "action": {
    "default_title": "Super Reader"
  },
  "background": {
    "service_worker": "src/platform/chrome/background.js"
  },
  "web_accessible_resources": [{
    "resources": ["src/content.css"],
    "matches": ["<all_urls>"]
  }]
}
