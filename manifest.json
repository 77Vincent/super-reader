{
  "manifest_version": 3,
  "name": "Super Reader - 中文视觉分块阅读",
  "version": "0.1.0",
  "description": "将中文长句按词义边界切成短语块，并用间隔出现的下划线辅助阅读。",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Super Reader",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "开启或关闭 Super Reader"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "css": ["src/content.css"],
      "js": ["src/chunker.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
