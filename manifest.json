{
  "manifest_version": 3,
  "name": "好读",
  "version": "0.1.0",
  "minimum_chrome_version": "109",
  "description": "按人类习惯，将长句拆分为短句，让阅读更轻松。",
  "permissions": ["offscreen", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "action": {
    "default_title": "好读",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": "Alt+Shift+R"
    }
  },
  "background": {
    "service_worker": "src/platform/chrome/background.js"
  },
  "web_accessible_resources": [{
    "resources": ["src/content.css"],
    "matches": ["<all_urls>"]
  }]
}
